# ── RS WALLET environment ─────────────────────────────────────────────────
# Copy to .env.local for local development. Never commit real secrets.

# Reown (WalletConnect) Project ID — REQUIRED for WalletConnect / AppKit.
# Create one at https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Public URL of this deployment (used in AppKit metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: CoinGecko Demo/Pro API key for higher market-data rate limits.
# The /api/prices route also accepts a server-only key (preferred).
NEXT_PUBLIC_COINGECKO_API_KEY=
COINGECKO_API_KEY=

# Optional: 0x Swap API key (server-only — never expose to the browser).
ZEROX_API_KEY=

# Optional: Etherscan API key (server-only) for block-explorer history
# in /api/history. One key serves all supported chains via Etherscan V2.
# Without it, Activity shows only transactions broadcast from this app.
ETHERSCAN_API_KEY=

# Optional: custom RPC endpoints (comma-separated fallbacks are not supported;
# one URL per chain). Leave empty to use the public defaults in src/lib/chains.ts
NEXT_PUBLIC_RPC_1=
NEXT_PUBLIC_RPC_56=
NEXT_PUBLIC_RPC_137=
NEXT_PUBLIC_RPC_42161=
NEXT_PUBLIC_RPC_10=
NEXT_PUBLIC_RPC_8453=
NEXT_PUBLIC_RPC_43114=
NEXT_PUBLIC_RPC_11155111=
